{
  "name": "bb-plugin-claude-bedrock",
  "version": "1.0.0",
  "description": "Run Claude Code threads on your AWS Bedrock account",
  "keywords": [
    "bb-plugin",
    "claude-code",
    "aws-bedrock",
    "bedrock",
    "provider"
  ],
  "license": "MIT",
  "author": "Alexander Klimetschek",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexkli/bb-plugin-claude-bedrock.git"
  },
  "type": "module",
  "engines": {
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "Claude Bedrock provider",
    "description": "Run Claude Code threads on your AWS Bedrock account",
    "branding": {
      "icon": "./assets/logo.svg"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx",
    "experimental_providers": [
      {
        "kind": "agent",
        "id": "claude-bedrock",
        "displayName": "Claude Code (Bedrock)"
      }
    ]
  },
  "scripts": {
    "build": "bb plugin build .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --config vitest.config.ts",
    "sync-upstream": "scripts/sync-upstream.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "@get-bb/plugin-sdk": "^0.6.132",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.93.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "better-sqlite3": "12.11.1",
    "cron-parser": "^5.10.3",
    "hono": "4.13.16",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  }
}
